# ---- Supabase (local dev defaults from `supabase start`) ----
# Replace with your hosted project's values when deploying.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_me
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_me

# ---- Auth allowlist ----
# Only this email can request a magic link. Any other login attempt is rejected.
ADMIN_EMAIL=ja2413059@gmail.com

# ---- App ----
# Used to build redirect URLs for magic-link callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Cron secret ----
# Required header `Authorization: Bearer <CRON_SECRET>` on /api/cron/* routes.
CRON_SECRET=generate_a_long_random_string
